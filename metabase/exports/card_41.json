    "native": {
      "query": "SELECT oi.order_id, oi.order_item_id, oi.product_id, oi.seller_id, oi.price, oi.freight_value, oi.shipping_limit_date, o.order_status, o.order_purchase_timestamp, o.order_delivered_customer_date, o.order_estimated_delivery_date, o.delay_days, o.delivery_severity, o.review_score, o.customer_city, o.customer_state FROM fct_order_items oi JOIN fct_orders o ON oi.order_id = o.order_id WHERE oi.seller_id = {{seller_id}} ORDER BY o.order_purchase_timestamp DESC",
