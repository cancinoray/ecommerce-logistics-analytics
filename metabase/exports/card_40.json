    "native": {
      "query": "SELECT delivery_severity, avg(freight_ratio) AS avg_freight_ratio, avg(total_freight_value) AS avg_freight_value, avg(delay_days) AS avg_delay_days, count(*) AS order_count FROM fct_orders GROUP BY delivery_severity ORDER BY delivery_severity"
