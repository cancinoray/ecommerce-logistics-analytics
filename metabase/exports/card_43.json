  "dataset_query": {
    "database": 2,
    "native": {
      "query": "SELECT o.order_id, o.order_status, o.order_purchase_timestamp, o.order_delivered_customer_date, o.order_estimated_delivery_date, o.delay_days, o.delivery_severity, o.review_score, o.customer_city, o.customer_state, o.total_price, o.total_freight_value, o.freight_ratio, oi.order_item_id, oi.product_id, oi.seller_id, oi.price, oi.freight_value FROM fct_orders o JOIN fct_order_items oi ON o.order_id = oi.order_id WHERE o.order_id = {{order_id}} ORDER BY oi.order_item_id",
