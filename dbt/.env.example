# Copy to dbt/.env and adjust as needed. Never commit the real .env file
# (it's gitignored at the repo root via `*.env` / `.env`).
#
# These are read by dbt/profiles.yml via env_var() - dbt debug/run/build
# will fail with a Jinja "env var required" error if any are unset.
#
# Values below match the ClickHouse container's defaults from
# docker-compose.yml (see AGENTS.md's "ClickHouse + Metabase access"
# section) - fine for local/portfolio use, not for a real deployment.

# Host to reach ClickHouse at.
# - Running `uv run dbt ...` from your host machine (ClickHouse port
#   published to localhost by docker-compose.yml): use `localhost`.
# - Running `docker compose exec dbt dbt ...` (dbt container talking to
#   the clickhouse container over the compose network): use `clickhouse`
#   (the service name) - already the default set on the `dbt` service in
#   docker-compose.yml, so no local .env is needed for that path.
CLICKHOUSE_HOST=localhost

# HTTP port (dbt-clickhouse's default driver is `http`).
CLICKHOUSE_PORT=8123

CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics

# Optional - defaults to `marts` in profiles.yml if unset.
CLICKHOUSE_SCHEMA=marts
